{
  "modelSettings": {
    "claude-sonnet-5-5": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    }
  },
  "model": "opus",
  "fallbackModel": [
    "opus",
    "sonnet"
  ],
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "haiku"
  },
  "permissions": {
    "deny": [
      "NotebookEdit"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "spec-dna hook context-meter --levels 300000,600000 --subagent 250000 2>/dev/null || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "spec-dna hook fanout-cap --cap 10 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
