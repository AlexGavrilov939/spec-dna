+    // The group `changes` sets the 3 new codes too.
+    let cfg =
+        config("lite", "").replace("SD608 = \"off\"", "SD608 = \"off\"\nchanges = \"warning\"");
+    let r = repo_with(&cfg);
+    change(&r, "accepted", "approved", "- [ ] t1: Write it.");
