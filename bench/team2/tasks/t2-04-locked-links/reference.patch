+        &doc("roadmap", "active", "", "- [Alpha](intent/alpha/intent.md)"),
+    );
+    r.write(
+        "docs/rules/pump.md",
+        &doc(
+            "rule",
+            "active",
+            "",
+            "## Rules\n\n- See [Alpha](../intent/alpha/intent.md).",
+        ),
+    );
+    r
